# Copy to .env; never commit the resulting file.
TJUSAI_API_KEY=
TJUSAI_BASE_URL=https://tjusai.top/v1
TJUSAI_MODEL=DeepSeek-V4.1-Flash
# App-side conservative budget, NOT a claim that the relay accepts 1M tokens.
REQUEST_TOKEN_BUDGET=262144
# Leave empty until the configured provider's actual limit is confirmed.
MODEL_CONTEXT_LIMIT=
MODEL_CONTEXT_VERIFIED=false
BASE_PATH=/wenxing
PORT=3001
# Use false only for local HTTP. compose.yaml enforces true for production HTTPS.
SECURE_COOKIES=false

# Generic external proxy network; set this for your own deployment.
GATEWAY_NETWORK=wenxing-gateway
